[
  {
    "version": 2,
    "id": "q06-state-pending-order",
    "desc": "R5：待付款订单进订单行，不带金额，不带已付款附句。",
    "tags": ["q06", "context"],
    "fixtures": {
      "now": "2026-10-02T12:00:00+08:00",
      "orders": [
        {
          "routeId": "r-yunnan-mid",
          "travelers": 2,
          "departDate": "2026-12-10",
          "status": "pending_payment"
        }
      ]
    },
    "turns": [
      {
        "say": "酒店是哪几家",
        "script": [
          {
            "content": "好的，我帮您看一下。"
          }
        ],
        "expect": {
          "contextMatches": ["^订单: 《云南 丽江大理·洱海古城 6 日》2 位、12月10日出发，待付款$"],
          "contextExcludes": ["已付款", "¥", "\\d元", "总价", "行程确认书"]
        }
      }
    ]
  },
  {
    "version": 2,
    "id": "q06-state-paid-order",
