  {
    "version": 2,
    "id": "q06-state-claims-paid-pending",
    "desc": "R5：自称已付而订单待付，加不得说已到账的口径行（旧版企微说在微信上联系）。",
    "tags": ["q06", "context"],
    "fixtures": {
      "now": "2026-10-02T12:00:00+08:00",
      "orders": [
        {
          "routeId": "r-yunnan-mid",
          "travelers": 2,
          "departDate": "2026-12-10",
          "status": "pending_payment"
        }
      ]
    },
    "turns": [
      {
        "say": "我已经付款了",
        "script": [
          {
            "content": "好的，我帮您看一下。"
          }
        ],
        "expect": {
          "contextMatches": [
            "^客户说已付款，但系统还没收到到账：不要说已到账、订单生效、订单已确认；要说就说「款项到账后您会收到确认，顾问核实后会在微信上联系您。」$"
          ],
          "contextExcludes": ["云途", "报价时机"]
        }
      }
    ]
  },
  {
    "version": 2,
    "id": "q06-state-claims-paid-no-order",
    "desc": "R5：没有任何订单、客户说付好了，同样加口径行。",
    "tags": ["q06", "context"],
    "fixtures": {
      "now": "2026-10-02T12:00:00+08:00"
    },
    "turns": [
      {
        "say": "我付好了",
        "script": [
          {
            "content": "好的，我帮您看一下。"
          }
        ],
        "expect": {
          "contextMatches": ["客户说已付款，但系统还没收到到账"],
          "contextExcludes": ["^订单:"]
        }
      }
    ]
  },
  {
    "version": 2,
    "id": "q06-state-negated-paid-claim",
    "desc": "R5：「还没付」「没转账」不算自称已付，不加口径行。",
    "tags": ["q06", "context"],
    "fixtures": {
      "now": "2026-10-02T12:00:00+08:00",
      "orders": [
        {
          "routeId": "r-yunnan-mid",
          "travelers": 2,
          "departDate": "2026-12-10",
          "status": "pending_payment"
        }
      ]
    },
    "turns": [
      {
        "say": "我还没付款，怎么付",
        "script": [
          {
            "content": "好的，我帮您看一下。"
          }
        ],
        "expect": {
          "contextExcludes": ["客户说已付款"]
        }
      },
      {
        "say": "没转账，先问下优惠",
        "script": [
          {
            "content": "好的，我帮您看一下。"
          }
        ],
        "expect": {
          "contextExcludes": ["客户说已付款"]
        }
      }
    ]
  },
  {
    "version": 2,
    "id": "q06-state-claims-paid-real-paid",
    "desc": "R5：会话里已有已付款订单时，不加「还没收到到账」的口径行。",
    "tags": ["q06", "context"],
    "fixtures": {
      "now": "2026-10-02T12:00:00+08:00",
      "orders": [
        {
          "routeId": "r-yunnan-mid",
          "travelers": 2,
          "departDate": "2026-12-10",
          "status": "paid"
        }
      ]
