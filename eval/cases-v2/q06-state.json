    "turns": [
      {
        "say": "我已经付款了",
        "script": [
          {
            "content": "好的。"
          }
        ],
        "expect": {
          "contextExcludes": ["还没收到到账", "客户说已付款"]
        }
      }
    ]
  },
  {
    "version": 2,
    "id": "q06-sensitive-asks",
    "desc": "R6：安全、开放、手续、证件、签证的问法有口径行，只说地名没有。",
    "tags": ["q06", "context"],
    "fixtures": {
      "now": "2026-10-02T12:00:00+08:00"
    },
    "turns": [
      {
        "say": "西藏现在安全吗",
        "script": [
          {
            "content": "好的，我帮您看一下。"
          }
        ],
        "expect": {
          "contextMatches": [
            "^客户问到敏感地区、安全或证件手续：统一说「这块政策会变，由顾问按您的出行时间确认」，不转人工；通行证只照线路的「含 / 不含」说；不给签证时长和费用；不说「正常开放」「不用办手续」「会协助办好」「身体负担小」$"
          ],
          "contextExcludes": ["报价时机"]
        }
      },
      {
        "say": "去新疆要办边防证吗",
        "script": [
          {
            "content": "好的，我帮您看一下。"
          }
        ],
        "expect": {
          "contextMatches": ["^客户问到敏感地区、安全或证件手续"]
        }
      },
      {
        "say": "日本签证要多久",
        "script": [
          {
            "content": "好的，我帮您看一下。"
          }
        ],
        "expect": {
          "contextMatches": ["^客户问到敏感地区、安全或证件手续"]
        }
      },
      {
        "say": "想去西藏",
        "script": [
          {
            "content": "好的，我帮您看一下。"
          }
        ],
        "expect": {
          "contextExcludes": ["敏感地区", "政策会变"]
        }
      },
      {
        "say": "新疆几月去好",
        "script": [
          {
            "content": "好的，我帮您看一下。"
          }
        ],
        "expect": {
          "contextExcludes": ["敏感地区", "政策会变"]
        }
      }
    ]
  }
]
