[
  {
    "version": 2,
    "pack": "industrial",
    "id": "q18-blocks-placeholder",
    "desc": "价格块：placeholder",
    "tags": ["q18", "industrial"],
    "fixtures": {
      "now": "2026-10-10T12:00:00+08:00"
    },
    "turns": [
      {
        "say": "6205-2RS 3件",
        "script": [
          {
            "content": "请核对。\n{{试算明细}}"
          }
        ],
        "expect": {
          "tools": ["quote_items"],
          "replyMatches": ["试算：", "单价10\\.00元", "小计30\\.00元", "合计30\\.00元"],
          "replyExcludes": ["\\{\\{", "\\}\\}"],
          "orders": {
            "count": 0
          }
        }
      }
    ]
  },
