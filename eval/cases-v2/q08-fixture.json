[
  {
    "version": 2,
    "id": "q08-fixture-line-order-01",
    "desc": "R11/验收 4：模型只给条目和数量，两行订单 200×3.65 + 50×12 = 133000 分；同样条目再下单复用待付单；改一行数量旧单作废、新单生效。",
    "tags": ["q08", "fixture", "line-order"],
    "pack": "__fixture",
    "fixtures": { "now": "2026-10-02T12:00:00+08:00" },
    "turns": [
      {
        "say": "甲方盒要200件、乙方盒要50件，帮我下单",
        "script": [
          {
            "toolCalls": [
              {
                "name": "fixture_order",
                "args": {
                  "lines": [
                    { "kind": "widget", "code": "w-a", "qty": 200 },
                    { "kind": "widget", "code": "w-b", "qty": 50 }
                  ]
                }
              }
            ]
          },
          { "content": "{{call:fixture_order.text}}\n复用已有订单：{{call:fixture_order.reused}}" }
        ],
        "expect": {
          "replyMatches": ["合成方盒甲 200件 3\\.65元/件 730元", "合成方盒乙 50件 12元/件 600元", "合计1,330元", "复用已有订单：false"],
          "tools": ["fixture_order"],
          "orders": {
            "count": 1,
            "last": {
              "v": 2,
              "status": "pending_payment",
              "totalFen": 133000,
              "lines": [
                { "kind": "widget", "code": "w-a", "qty": 200, "unitPriceFen": 365, "amountFen": 73000 },
                { "kind": "widget", "code": "w-b", "qty": 50, "unitPriceFen": 1200, "amountFen": 60000 }
              ]
            }
          }
        }
      },
      {
        "say": "再按刚才的数量下一次单",
        "script": [
          {
            "toolCalls": [
              {
                "name": "fixture_order",
                "args": {
                  "lines": [
                    { "kind": "widget", "code": "w-b", "qty": 50 },
                    { "kind": "widget", "code": "w-a", "qty": 200 }
                  ]
                }
              }
            ]
          },
          { "content": "合计{{call:fixture_order.display.totalText}}\n复用已有订单：{{call:fixture_order.reused}}" }
        ],
        "expect": {
          "replyMatches": ["合计1,330元", "复用已有订单：true"],
          "tools": ["fixture_order"],
          "orders": {
            "count": 1,
            "last": { "status": "pending_payment", "totalFen": 133000 }
          }
        }
      },
      {
        "say": "乙方盒改成60件",
        "script": [
          {
            "toolCalls": [
              {
                "name": "fixture_order",
                "args": {
                  "lines": [
                    { "kind": "widget", "code": "w-a", "qty": 200 },
                    { "kind": "widget", "code": "w-b", "qty": 60 }
                  ]
                }
              }
            ]
          },
          {
            "content": "合计{{call:fixture_order.display.totalText}}\n复用已有订单：{{call:fixture_order.reused}}\n最新订单状态：{{order:0.status}}\n最新订单乙方盒数量：{{order:0.lines.1.qty}}"
          }
        ],
        "expect": {
          "replyMatches": ["合计1,450元", "复用已有订单：false", "最新订单状态：pending_payment", "最新订单乙方盒数量：60"],
          "tools": ["fixture_order"],
          "orders": {
            "count": 2,
            "last": {
              "status": "superseded",
              "totalFen": 133000,
              "lines": [
                { "kind": "widget", "code": "w-a", "qty": 200, "unitPriceFen": 365, "amountFen": 73000 },
                { "kind": "widget", "code": "w-b", "qty": 50, "unitPriceFen": 1200, "amountFen": 60000 }
              ]
            }
          }
        }
      }
    ]
  },
