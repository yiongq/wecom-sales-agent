  {
    "version": 2,
    "id": "q08-fixture-attrs-merge-01",
    "desc": "R4/验收 7：两轮分别抽出 attrs 的两个键（颜色、尺寸）；第三轮的画像里两个键都在，后一轮不整块覆盖前一轮。画像在回复之后才抽取，所以状态要到下一轮才看得到。",
    "tags": ["q08", "fixture", "attrs"],
    "pack": "__fixture",
    "fixtures": { "now": "2026-10-02T12:00:00+08:00" },
    "turns": [
      {
        "say": "颜色：红",
        "script": [{ "content": "收到，颜色记下了。" }],
        "expect": {
          "replyMatches": ["收到，颜色记下了"],
          "contextMatches": ["客户画像: \\{\\}"],
          "contextExcludes": ["attrs"]
        }
      },
      {
        "say": "尺寸：大",
        "script": [{ "content": "收到，尺寸记下了。" }],
        "expect": {
          "replyMatches": ["收到，尺寸记下了"],
          "contextMatches": ["\"attrs\":\\{\"color\":\"红\"\\}"],
          "contextExcludes": ["size"]
        }
      },
      {
        "say": "先确认一下我说的",
        "script": [{ "content": "好的，已记下颜色和尺寸。" }],
        "expect": {
          "replyMatches": ["已记下颜色和尺寸"],
          "contextMatches": ["\"attrs\":\\{\"color\":\"红\",\"size\":\"大\"\\}"]
        }
      }
    ]
  },
