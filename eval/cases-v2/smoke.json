  {
    "version": 2,
    "id": "travel-engine-164-order-smoke",
    "desc": "一次建单调用及工具结果和订单占位",
    "tags": ["冒烟"],
    "fixtures": {
      "now": "2026-10-02T12:00:00+08:00",
      "session": { "stage": "quote", "profile": { "travelers": "2人", "dates": "2026-12-10" }, "seenRouteIds": ["r-yunnan-mid"] }
    },
    "turns": [
      {
        "say": "就订云南这条，2人，2026-12-10出发",
        "script": [
          { "toolCalls": [{ "name": "create_order", "args": { "routeId": "r-yunnan-mid", "travelers": 2, "departDate": "2026-12-10" } }] },
          { "content": "请点击付款链接：{{call:create_order.payUrl}}<state>{\"stage\":\"closing\"}</state>" }
        ],
        "expect": {
          "replyMatches": ["/pay/{{order:0.id}}"],
          "replyExcludes": ["脚本耗尽"],
          "stage": "closing",
          "tools": ["create_order"],
          "orders": {
            "count": 1,
            "last": { "id": "{{call:create_order.orderId}}", "travelers": 2, "departDate": "2026-12-10", "status": "pending_payment" }
          },
          "handoff": false
        }
      }
    ]
  },
