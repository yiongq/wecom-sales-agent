  {
    "version": 2,
    "id": "q07-policy-ask-insurance-fees",
    "desc": "R14：保险、费用含不含只给那一句口径，不带退改条款；一句话问了两样各出一句；「保险起见」不算保险问法。",
    "tags": ["q07", "context"],
    "fixtures": {
      "now": "2026-10-02T12:00:00+08:00"
    },
    "turns": [
      {
        "say": "这条线含保险吗",
        "script": [
          {
            "content": "保险含不含，要看这条线的费用说明；说明里没写的，由顾问跟您确认（保险说明）。"
          }
        ],
        "expect": {
          "contextMatches": [
            "^可引用的条款（照原文说，说到哪条就在句末写出处）：$",
            "^（保险说明）保险含不含、保哪些，要看这条线的费用说明；说明里没写的，由顾问跟您确认。$"
          ],
          "contextExcludes": ["^（退改条款", "^（改期条款", "^（费用说明", "^您这张单"]
        }
      },
      {
        "say": "机票包含吗",
        "script": [
          {
            "content": "费用含不含哪些项目，要看这条线的费用说明（费用说明）。"
          }
        ],
        "expect": {
          "contextMatches": [
            "^可引用的条款（照原文说，说到哪条就在句末写出处）：$",
            "^（费用说明）费用里含不含哪些项目，要看这条线的费用说明；说明里没写的，由顾问跟您确认。$"
          ],
          "contextExcludes": ["^（退改条款", "^（改期条款", "^（保险说明", "^您这张单"]
        }
      },
      {
        "say": "机票和保险含不含",
        "script": [
          {
            "content": "都要看费用说明。"
          }
        ],
        "expect": {
          "contextMatches": [
            "^可引用的条款（照原文说，说到哪条就在句末写出处）：$",
            "^（保险说明）保险含不含、保哪些，要看这条线的费用说明；说明里没写的，由顾问跟您确认。$",
            "^（费用说明）费用里含不含哪些项目，要看这条线的费用说明；说明里没写的，由顾问跟您确认。$"
          ],
          "contextExcludes": ["^（退改条款"]
        }
      },
      {
        "say": "保险起见，我再想想",
        "script": [
          {
            "content": "好的，不急。"
          }
        ],
        "expect": {
          "contextExcludes": ["^可引用的条款", "^（退改条款", "^（改期条款", "^（保险说明", "^（费用说明", "^您这张单"]
        }
      }
    ]
  },
