  {
    "version": 2,
    "pack": "industrial",
    "id": "q12-industrial-sheet-confirm",
    "desc": "合并表头的 XLSX：确认前只有清单（无价格、无试算），确认后一次预取试算，单价与合计与 quote_items 一致，未匹配的行不报价并进通知",
    "tags": ["q12", "industrial"],
    "fixtures": {
      "now": "2026-10-10T12:00:00+08:00"
    },
    "turns": [
      {
        "attach": {
          "file": "rfq-merged-header.xlsx"
        },
        "expect": {
          "replyMatches": [
            "^从您发来的询价单里认出 12 行，请核对：$",
            "^1\\. 6205-2RS，100件，已匹配$",
            "^10\\. HS-K02-24，10件，已匹配$",
            "^11\\. 6211-2RS，数量没认出，待确认：数量没认出，请补数量$",
            "^12\\. ZZ9999，3件，库里没找到，顾问会核对$",
            "^回「确认」我按已匹配的行算价；要改哪行，回「第几行 型号 数量」；不要哪行，回「删第几行」。$"
          ],
          "tools": [],
          "handoff": false,
          "replyExcludes": ["元", "单价", "合计"],
          "orders": {
            "count": 0
          }
        }
      },
      {
        "say": "确认",
        "expect": {
          "tools": ["quote_items"],
          "handoff": false,
          "replyMatches": [
            "6205-2RS 单价{{call:quote_items.lines.0.unitPrice}}元，金额{{call:quote_items.lines.0.amount}}元",
            "HS-K02-24 单价{{call:quote_items.lines.9.unitPrice}}元，金额{{call:quote_items.lines.9.amount}}元",
            "合计{{call:quote_items.total}}元",
            "第11、12行"
          ],
          "contextMatches": ["客户刚确认了识别清单：已匹配的行已按清单试算", "清单第11、12行不报价，已通知顾问核对"],
          "orders": {
            "count": 0
          }
        },
        "script": [
          {
            "content": "按已匹配的 10 行试算：\n{{call:quote_items.lines.0.partNo}} 单价{{call:quote_items.lines.0.unitPrice}}元，金额{{call:quote_items.lines.0.amount}}元\n{{call:quote_items.lines.9.partNo}} 单价{{call:quote_items.lines.9.unitPrice}}元，金额{{call:quote_items.lines.9.amount}}元\n合计{{call:quote_items.total}}元。第11、12行没有报价，已请顾问核对。"
          }
        ]
      },
      {
        "say": "确认",
        "expect": {
          "tools": [],
          "handoff": false,
          "contextMatches": ["\"status\":\"confirmed\""],
          "contextExcludes": ["还没确认", "客户刚确认了识别清单"],
          "orders": {
            "count": 0
          }
        },
        "script": [
          {
            "content": "好的。"
          }
        ]
      }
    ]
  },
