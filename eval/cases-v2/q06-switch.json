[
  {
    "version": 2,
    "id": "q06-switch-pending-order",
    "desc": "R8：有云南待付款单、客户问「四川呢」：预取四川并有换目的地行。",
    "tags": ["q06", "prefetch"],
    "fixtures": {
      "now": "2026-10-02T12:00:00+08:00",
      "orders": [
        {
          "routeId": "r-yunnan-mid",
          "travelers": 2,
          "departDate": "2026-12-10",
          "status": "pending_payment"
        }
      ],
      "session": {
        "stage": "closing"
      }
    },
    "turns": [
      {
        "say": "四川呢",
        "script": [
          {
            "content": "我帮您看一下。"
          }
        ],
        "expect": {
          "tools": ["search_routes"],
          "contextMatches": [
            "^客户这轮问到四川；会话里还有云南的待付款订单，它不会因为聊四川而自动作废：照实回答四川；说到那张单，就照「订单」一行说：旧单仍然有效，「之前那张单请先别付款，我请顾问帮您处理」，不说「不冲突」「自动失效」，继续聊四川$"
          ]
        }
      }
    ]
  },
