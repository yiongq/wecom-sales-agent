{
  "id": "qa-rec-quote-yunnan",
  "persona": "你是第一次咨询的客户，第一句话已说：「两个人，国庆想去云南，一人预算三万左右」，没有给具体日期。对方推荐后你挑一条问报价，得到每人价、总价后追问一次「这个价格是国庆的价吗」，再说「好的我考虑下」并结束。不下单，不要人工。",
  "maxTurns": 9,
  "allowedTools": [
    "search_routes",
    "get_route_detail",
    "search_hotels",
    "create_quote",
    "generate_proposal",
    "create_order",
    "handoff_to_human"
  ],
  "predicates": [
    {
      "kind": "order",
      "count": 0
    },
    {
      "kind": "handoff",
      "expected": false
    },
    {
      "kind": "tool_called",
      "name": "search_routes",
      "min": 1
    },
    {
      "kind": "tool_called",
      "name": "create_quote",
      "min": 1
    },
    {
      "kind": "reply_excludes",
      "pattern": "节假日价|旺季价|平日价|周末价|儿童价|早鸟|团购|半价|名额紧张|名额有限|房源紧俏|(?:这条线|该线路|线路|名额|档期|房源|位置|房间|席位)[^。，\\n]{0,6}抢手|最低价",
      "scope": "all",
      "negationAware": true
    },
    {
      "kind": "reply_excludes",
      "pattern": "产品库|线路库|系统里|查库|库里|工具返回",
      "scope": "all"
    },
    {
      "kind": "reply_excludes",
      "pattern": "availability|budget|package|option",
      "scope": "all"
    },
    {
      "kind": "reply_excludes",
      "pattern": "(?:[\\u{1F300}-\\u{1FAFF}\\u2600-\\u27BF].*){2,}",
      "scope": "all"
    },
    {
      "kind": "reply_excludes",
      "pattern": "更正一下|报错了|算错了|重新(?:算|报)了|刚才.{0,8}(?:说|报)(?:错|的不对)|之前.{0,6}(?:有误|不准)",
      "scope": "all"
    },
    {
      "kind": "reply_matches",
      "pattern": "每人|人均|总价|共计",
      "scope": "any"
    },
    {
      "kind": "reply_excludes",
      "pattern": "按最终行程.{0,8}微调|最终按行程微调|可能微调",
      "scope": "all",
      "after": {
        "tool": "create_quote"
      }
    },
    {
      "kind": "reply_excludes",
      "pattern": "(?:这是|是|为|均为|仅为|以上为|报价为)起价|起价[，,]",
      "scope": "all",
      "negationAware": true,
      "after": {
        "tool": "create_quote"
      }
    },
    {
      "kind": "reply_matches",
      "pattern": "不含.{0,12}(?:大交通|机票|往返)|(?:大交通|机票|往返交通).{0,10}(?:不含|另计|自理|另付|不包含)",
      "scope": "any"
    },
    {
      "kind": "reply_excludes",
      "pattern": "锁(?:定)?(?:名额|档期)|先锁(?:定)?|帮您锁|名额(?:紧张|有限)|抢手",
      "scope": "all",
      "negationAware": true
    },
    {
      "kind": "reply_excludes",
      "pattern": "(?<!不)节假日",
      "scope": "all"
    },
    {
      "kind": "reply_excludes",
      "pattern": "不上浮|淡季",
      "scope": "all"
    },
    {
      "kind": "shape",
      "richMax": 6,
      "plainMax": 3,
      "minShare": 0.7
    }
  ],
  "forbidden": ["保证有房", "保证成行", "我保证给您升级酒店", "<state>", "<tool_call>", "【硬性要求】"],
  "severity": "quality",
  "covers": ["F", "G", "K", "O", "R", "S"],
  "customerScript": ["两个人，国庆想去云南，一人预算三万左右"]
}
