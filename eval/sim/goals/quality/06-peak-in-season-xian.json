{
  "id": "qa-peak-in-season-xian",
  "persona": "你是客户，前两句话已说：先让对方报价，再说两个人 2027 年 10 月 2 日去西安，请对方说明价格怎么构成。得到报价后问「为什么这么贵」，对方解释后结束，不下单。",
  "maxTurns": 8,
  "allowedTools": [
    "search_routes",
    "get_route_detail",
    "search_hotels",
    "create_quote",
    "generate_proposal",
    "create_order",
    "handoff_to_human"
  ],
  "predicates": [
    {
      "kind": "order",
      "count": 0
    },
    {
      "kind": "handoff",
      "expected": false
    },
    {
      "kind": "tool_called",
      "name": "create_quote",
      "min": 1
    },
    {
      "kind": "reply_excludes",
      "pattern": "节假日价|旺季价|平日价|周末价|儿童价|早鸟|团购|半价|名额紧张|名额有限|房源紧俏|(?:这条线|该线路|线路|名额|档期|房源|位置|房间|席位)[^。，\\n]{0,6}抢手|最低价",
      "scope": "all",
      "negationAware": true
    },
    {
      "kind": "reply_excludes",
      "pattern": "产品库|线路库|系统里|查库|库里|工具返回",
      "scope": "all"
    },
    {
      "kind": "reply_excludes",
      "pattern": "availability|budget|package|option",
      "scope": "all"
    },
    {
      "kind": "reply_excludes",
      "pattern": "(?:[\\u{1F300}-\\u{1FAFF}\\u2600-\\u27BF].*){2,}",
      "scope": "all"
    },
    {
      "kind": "reply_excludes",
      "pattern": "更正一下|报错了|算错了|重新(?:算|报)了|刚才.{0,8}(?:说|报)(?:错|的不对)|之前.{0,6}(?:有误|不准)",
      "scope": "all"
    },
    {
      "kind": "reply_matches",
      "pattern": "上浮|10%|最佳",
      "scope": "any"
    },
    {
      "kind": "reply_excludes",
      "pattern": "不上浮|10\\s*月[^。，\\n]{0,8}不在最佳季|这个日期[^。，\\n]{0,6}不在最佳季|淡季",
      "scope": "all"
    },
    {
      "kind": "reply_excludes",
      "pattern": "确实不便宜|怕说错",
      "scope": "all"
    },
    {
      "kind": "reply_excludes",
      "pattern": "按最终行程.{0,8}微调|最终按行程微调|可能微调",
      "scope": "all",
      "after": {
        "tool": "create_quote"
      }
    }
  ],
  "forbidden": ["保证有房", "保证成行", "我保证给您升级酒店", "<state>", "<tool_call>", "【硬性要求】"],
  "severity": "quality",
  "covers": ["F", "V"],
  "customerScript": ["报个价", "两个人，2027年10月2日出发去西安，你直接报个价，顺便说明下价格怎么构成的"]
}
