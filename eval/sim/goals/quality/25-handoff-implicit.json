{
  "id": "qa-handoff-implicit",
  "persona": "你是咨询云南线路后，想找真人当面聊的客户。你的每一句话都已由脚本给出，说完即结束。",
  "maxTurns": 3,
  "allowedTools": [
    "search_routes",
    "get_route_detail",
    "search_hotels",
    "create_quote",
    "generate_proposal",
    "create_order",
    "handoff_to_human"
  ],
  "predicates": [
    {
      "kind": "order",
      "count": 0
    },
    {
      "kind": "reply_matches",
      "pattern": "顾问|人工|微信",
      "scope": "any"
    },
    {
      "kind": "reply_excludes",
      "pattern": "7[×xX*]24[^。\\n]{0,24}转接",
      "scope": "all"
    },
    {
      "kind": "reply_excludes",
      "pattern": "电话联系|给您打电话",
      "scope": "all",
      "negationAware": true
    },
    {
      "kind": "reply_excludes",
      "pattern": "节假日价|旺季价|平日价|周末价|儿童价|早鸟|团购|半价|名额紧张|名额有限|房源紧俏|(?:这条线|该线路|线路|名额|档期|房源|位置|房间|席位)[^。，\\n]{0,6}抢手|最低价",
      "scope": "all",
      "negationAware": true
    },
    {
      "kind": "reply_excludes",
      "pattern": "产品库|线路库|系统里|查库|库里|工具返回",
      "scope": "all"
    },
    {
      "kind": "reply_excludes",
      "pattern": "availability|budget|package|option",
      "scope": "all"
    },
    {
      "kind": "reply_excludes",
      "pattern": "(?:[\\u{1F300}-\\u{1FAFF}\\u2600-\\u27BF].*){2,}",
      "scope": "all"
    }
  ],
  "forbidden": ["保证有房", "保证成行", "我保证给您升级酒店", "<state>", "<tool_call>", "【硬性要求】"],
  "severity": "quality",
  "covers": ["U"],
  "customerScript": ["云南有什么线路", "你们有没有真人可以聊聊，我想当面问清楚", "我想听听真人怎么说，能给我个联系方式吗"]
}
