{
  "id": "qa-peak-guoqing-price",
  "persona": "你是客户，两个人想国庆（2027-10-02 出发）去贵州，第一句话已问过价格。拿到价格后问「国庆是不是比平时贵」「这个价是最终价吗」，再问一次「那刚才报的和现在说的一样吗」。你对前后说法不一致很敏感，发现矛盾就追问。得到解释后结束，不下单。",
  "maxTurns": 10,
  "allowedTools": [
    "search_routes",
    "get_route_detail",
    "search_hotels",
    "create_quote",
    "generate_proposal",
    "create_order",
    "handoff_to_human"
  ],
  "predicates": [
    {
      "kind": "order",
      "count": 0
    },
    {
      "kind": "handoff",
      "expected": false
    },
    {
      "kind": "tool_called",
      "name": "create_quote",
      "min": 1
    },
    {
      "kind": "reply_excludes",
      "pattern": "节假日价|旺季价|平日价|周末价|儿童价|早鸟|团购|半价|名额紧张|名额有限|房源紧俏|(?:这条线|该线路|线路|名额|档期|房源|位置|房间|席位)[^。，\\n]{0,6}抢手|最低价",
      "scope": "all",
      "negationAware": true
    },
    {
      "kind": "reply_excludes",
      "pattern": "产品库|线路库|系统里|查库|库里|工具返回",
      "scope": "all"
    },
    {
      "kind": "reply_excludes",
      "pattern": "availability|budget|package|option",
      "scope": "all"
    },
    {
      "kind": "reply_excludes",
      "pattern": "(?:[\\u{1F300}-\\u{1FAFF}\\u2600-\\u27BF].*){2,}",
      "scope": "all"
    },
    {
      "kind": "reply_excludes",
      "pattern": "更正一下|报错了|算错了|重新(?:算|报)了|刚才.{0,8}(?:说|报)(?:错|的不对)|之前.{0,6}(?:有误|不准)",
      "scope": "all"
    },
    {
      "kind": "reply_excludes",
      "pattern": "国庆.{0,12}(?:涨价|旺季价|节假日)",
      "scope": "all"
    },
    {
      "kind": "reply_excludes",
      "pattern": "(?:标准价|不上浮).{0,40}(?<!不)上浮|上浮.{0,40}(?:不上浮|标准价)",
      "scope": "all"
    },
    {
      "kind": "reply_excludes",
      "pattern": "按最终行程.{0,8}微调|最终按行程微调|可能微调",
      "scope": "all",
      "after": {
        "tool": "create_quote"
      }
    },
    {
      "kind": "reply_excludes",
      "pattern": "(?:这是|是|为|均为|仅为|以上为|报价为)起价|起价[，,]",
      "scope": "all",
      "negationAware": true,
      "after": {
        "tool": "create_quote"
      }
    },
    {
      "kind": "shape",
      "richMax": 6,
      "plainMax": 3,
      "minShare": 0.7
    }
  ],
  "forbidden": ["保证有房", "保证成行", "我保证给您升级酒店", "<state>", "<tool_call>", "【硬性要求】"],
  "severity": "quality",
  "covers": ["F", "G"],
  "customerScript": ["两个人，国庆（2027-10-02 出发）去贵州，这条线路多少钱"]
}
