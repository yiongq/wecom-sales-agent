{
  "id": "qa-proposal-request",
  "persona": "你是客户，两个人 2027-09-20 想去贵州，第一句话已请对方出详细方案。拿到方案书链接后问「方案里有什么，含不含餐」。答复后结束，不下单。",
  "maxTurns": 8,
  "allowedTools": [
    "search_routes",
    "get_route_detail",
    "search_hotels",
    "create_quote",
    "generate_proposal",
    "create_order",
    "handoff_to_human"
  ],
  "predicates": [
    {
      "kind": "order",
      "count": 0
    },
    {
      "kind": "tool_called",
      "name": "generate_proposal",
      "min": 1
    },
    {
      "kind": "reply_matches",
      "pattern": "http|/p/|方案",
      "scope": "any"
    },
    {
      "kind": "reply_excludes",
      "pattern": "多出的一天在",
      "scope": "all"
    },
    {
      "kind": "reply_excludes",
      "pattern": "节假日价|旺季价|平日价|周末价|儿童价|早鸟|团购|半价|名额紧张|名额有限|房源紧俏|(?:这条线|该线路|线路|名额|档期|房源|位置|房间|席位)[^。，\\n]{0,6}抢手|最低价",
      "scope": "all",
      "negationAware": true
    },
    {
      "kind": "reply_excludes",
      "pattern": "产品库|线路库|系统里|查库|库里|工具返回",
      "scope": "all"
    },
    {
      "kind": "reply_excludes",
      "pattern": "availability|budget|package|option",
      "scope": "all"
    },
    {
      "kind": "reply_excludes",
      "pattern": "(?:[\\u{1F300}-\\u{1FAFF}\\u2600-\\u27BF].*){2,}",
      "scope": "all"
    },
    {
      "kind": "shape",
      "richMax": 6,
      "plainMax": 3,
      "minShare": 0.7
    }
  ],
  "forbidden": ["保证有房", "保证成行", "我保证给您升级酒店", "<state>", "<tool_call>", "【硬性要求】"],
  "severity": "quality",
  "covers": ["P", "T"],
  "customerScript": ["贵州五日游，两个人，2027-09-20 出发，出个详细方案"]
}
