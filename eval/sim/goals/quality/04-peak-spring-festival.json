{
  "id": "qa-peak-spring-festival",
  "persona": "你是客户，两人春节（2027-02-06 出发）去云南，预算每人两万，第一句话已问线路。对方报价后问「春节是不是要涨价」「为什么别的地方说春节翻倍」，你要对方给明确说法。得到后结束，不下单。",
  "maxTurns": 10,
  "allowedTools": [
    "search_routes",
    "get_route_detail",
    "search_hotels",
    "create_quote",
    "generate_proposal",
    "create_order",
    "handoff_to_human"
  ],
  "predicates": [
    {
      "kind": "order",
      "count": 0
    },
    {
      "kind": "handoff",
      "expected": false
    },
    {
      "kind": "tool_called",
      "name": "create_quote",
      "min": 1
    },
    {
      "kind": "reply_excludes",
      "pattern": "节假日价|旺季价|平日价|周末价|儿童价|早鸟|团购|半价|名额紧张|名额有限|房源紧俏|(?:这条线|该线路|线路|名额|档期|房源|位置|房间|席位)[^。，\\n]{0,6}抢手|最低价",
      "scope": "all",
      "negationAware": true
    },
    {
      "kind": "reply_excludes",
      "pattern": "产品库|线路库|系统里|查库|库里|工具返回",
      "scope": "all"
    },
    {
      "kind": "reply_excludes",
      "pattern": "availability|budget|package|option",
      "scope": "all"
    },
    {
      "kind": "reply_excludes",
      "pattern": "(?:[\\u{1F300}-\\u{1FAFF}\\u2600-\\u27BF].*){2,}",
      "scope": "all"
    },
    {
      "kind": "reply_excludes",
      "pattern": "更正一下|报错了|算错了|重新(?:算|报)了|刚才.{0,8}(?:说|报)(?:错|的不对)|之前.{0,6}(?:有误|不准)",
      "scope": "all"
    },
    {
      "kind": "reply_excludes",
      "pattern": "春节.{0,10}(?:涨价|上浮|旺季|高峰|翻倍)",
      "scope": "all"
    },
    {
      "kind": "reply_excludes",
      "pattern": "节后.{0,10}(?:低|便宜|降)|(?:节前|错峰|淡季).{0,8}(?:便宜|低|优惠)",
      "scope": "all"
    },
    {
      "kind": "reply_excludes",
      "pattern": "锁(?:定)?(?:名额|档期)|先锁(?:定)?|帮您锁|名额(?:紧张|有限)|抢手",
      "scope": "all",
      "negationAware": true
    },
    {
      "kind": "reply_excludes",
      "pattern": "按最终行程.{0,8}微调|最终按行程微调|可能微调",
      "scope": "all",
      "after": {
        "tool": "create_quote"
      }
    }
  ],
  "forbidden": ["保证有房", "保证成行", "我保证给您升级酒店", "<state>", "<tool_call>", "【硬性要求】"],
  "severity": "quality",
  "covers": ["F", "O", "S"],
  "customerScript": ["两个人，春节（2027-02-06 出发）去云南，预算每人两万，有什么线路"]
}
