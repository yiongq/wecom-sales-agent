{
  "id": "qa-date-far-future",
  "persona": "你是想订三年后国庆出行的客户，想先锁定价格。你的每一句话都已由脚本给出，说完即结束。",
  "maxTurns": 2,
  "allowedTools": [
    "search_routes",
    "get_route_detail",
    "search_hotels",
    "create_quote",
    "generate_proposal",
    "create_order",
    "handoff_to_human"
  ],
  "predicates": [
    {
      "kind": "order",
      "count": 0
    },
    {
      "kind": "handoff",
      "expected": false
    },
    {
      "kind": "reply_excludes",
      "pattern": "(?:可以|能|现在就能)先?锁定|先锁定(?:名额|档期|价格)",
      "scope": "all",
      "negationAware": true
    },
    {
      "kind": "reply_excludes",
      "pattern": "保证.{0,6}(?:价格不变|锁定|有房)",
      "scope": "all",
      "negationAware": true
    },
    {
      "kind": "reply_excludes",
      "pattern": "[0-9一二三四五六七八九十]+\\s*[-–~到至]\\s*[0-9一二三四五六七八九十]+\\s*个月前",
      "scope": "all"
    },
    {
      "kind": "reply_excludes",
      "pattern": "锁(?:定)?(?:名额|档期)|先锁(?:定)?|帮您锁|名额(?:紧张|有限)|抢手",
      "scope": "all",
      "negationAware": true
    },
    {
      "kind": "reply_excludes",
      "pattern": "节假日价|旺季价|平日价|周末价|儿童价|早鸟|团购|半价|名额紧张|名额有限|房源紧俏|(?:这条线|该线路|线路|名额|档期|房源|位置|房间|席位)[^。，\\n]{0,6}抢手|最低价",
      "scope": "all",
      "negationAware": true
    },
    {
      "kind": "reply_excludes",
      "pattern": "产品库|线路库|系统里|查库|库里|工具返回",
      "scope": "all"
    },
    {
      "kind": "reply_excludes",
      "pattern": "availability|budget|package|option",
      "scope": "all"
    },
    {
      "kind": "reply_excludes",
      "pattern": "(?:[\\u{1F300}-\\u{1FAFF}\\u2600-\\u27BF].*){2,}",
      "scope": "all"
    }
  ],
  "forbidden": ["保证有房", "保证成行", "我保证给您升级酒店", "<state>", "<tool_call>", "【硬性要求】"],
  "severity": "quality",
  "covers": ["L", "O"],
  "customerScript": ["我们两个人计划三年后，2029 年国庆去云南，现在能订吗？价格大概多少？", "那现在能先锁定吗？"]
}
