{
  "id": "qa-policy-ask-refund-rules",
  "persona": "你是还没下单、想先问清退改规则的客户，没有订单。你的每一句话都已由脚本给出，说完即结束。",
  "maxTurns": 2,
  "allowedTools": [
    "search_routes",
    "get_route_detail",
    "search_hotels",
    "create_quote",
    "generate_proposal",
    "create_order",
    "handoff_to_human"
  ],
  "predicates": [
    {
      "kind": "order",
      "count": 0
    },
    {
      "kind": "handoff",
      "expected": false
    },
    {
      "kind": "reply_matches",
      "pattern": "（退改条款第[1-4]条）(?=[。！？!?～~\\s]|$)",
      "scope": "any"
    },
    {
      "kind": "reply_excludes",
      "pattern": "(?:出发前|提前)\\s*(?!(?:30|15|7|0)(?!\\d))\\d+|(?:出发前|提前)\\s*\\d+\\s*[–\\-~～到至]\\s*(?!(?:29|14|6)(?!\\d))\\d+",
      "scope": "all"
    },
    {
      "kind": "reply_excludes",
      "pattern": "(?<!\\d)(?!(?:100|80|50)(?!\\d)\\s*%)\\d+\\s*%",
      "scope": "all"
    },
    {
      "kind": "reply_excludes",
      "pattern": "出发前\\s*(?:15|29|7|14|6|0)(?:\\s*[–\\-~～到至]\\s*\\d+)?\\s*天[^。！？!?；;\\n（]{0,10}(?:全额|全款|100\\s*%)",
      "scope": "all"
    },
    {
      "kind": "reply_excludes",
      "pattern": "节假日价|旺季价|平日价|周末价|儿童价|早鸟|团购|半价|名额紧张|名额有限|房源紧俏|(?:这条线|该线路|线路|名额|档期|房源|位置|房间|席位)[^。，\\n]{0,6}抢手|最低价",
      "scope": "all",
      "negationAware": true
    },
    {
      "kind": "reply_excludes",
      "pattern": "产品库|线路库|系统里|查库|库里|工具返回",
      "scope": "all"
    },
    {
      "kind": "reply_excludes",
      "pattern": "availability|budget|package|option",
      "scope": "all"
    },
    {
      "kind": "reply_excludes",
      "pattern": "(?:[\\u{1F300}-\\u{1FAFF}\\u2600-\\u27BF].*){2,}",
      "scope": "all"
    }
  ],
  "forbidden": ["保证有房", "保证成行", "我保证给您升级酒店", "<state>", "<tool_call>", "【硬性要求】"],
  "severity": "quality",
  "tags": ["regression"],
  "covers": [],
  "customerScript": ["想先问清楚：如果临时去不了，退改怎么算？", "那改期可以吗，怎么改？"]
}
