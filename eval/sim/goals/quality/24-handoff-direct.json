{
  "id": "qa-handoff-direct",
  "persona": "你是只发「人工」两个字的客户。你的每一句话都已由脚本给出，说完即结束。",
  "maxTurns": 1,
  "allowedTools": [
    "search_routes",
    "get_route_detail",
    "search_hotels",
    "create_quote",
    "generate_proposal",
    "create_order",
    "handoff_to_human"
  ],
  "predicates": [
    {
      "kind": "handoff",
      "expected": true
    },
    {
      "kind": "order",
      "count": 0
    },
    {
      "kind": "reply_matches",
      "pattern": "顾问|人工|转接",
      "scope": "any"
    },
    {
      "kind": "reply_matches",
      "pattern": "顾问.{0,8}(?:联系|回复)您",
      "scope": "any"
    },
    {
      "kind": "reply_excludes",
      "pattern": "7[×xX*]24[^。\\n]{0,24}转接",
      "scope": "all"
    },
    {
      "kind": "reply_excludes",
      "pattern": "随时找我|随时告诉我|我马上帮您查",
      "scope": "all"
    },
    {
      "kind": "reply_excludes",
      "pattern": "电话",
      "scope": "all",
      "negationAware": true
    },
    {
      "kind": "reply_excludes",
      "pattern": "节假日价|旺季价|平日价|周末价|儿童价|早鸟|团购|半价|名额紧张|名额有限|房源紧俏|(?:这条线|该线路|线路|名额|档期|房源|位置|房间|席位)[^。，\\n]{0,6}抢手|最低价",
      "scope": "all",
      "negationAware": true
    },
    {
      "kind": "reply_excludes",
      "pattern": "产品库|线路库|系统里|查库|库里|工具返回",
      "scope": "all"
    },
    {
      "kind": "reply_excludes",
      "pattern": "availability|budget|package|option",
      "scope": "all"
    },
    {
      "kind": "reply_excludes",
      "pattern": "(?:[\\u{1F300}-\\u{1FAFF}\\u2600-\\u27BF].*){2,}",
      "scope": "all"
    }
  ],
  "forbidden": ["保证有房", "保证成行", "我保证给您升级酒店", "<state>", "<tool_call>", "【硬性要求】"],
  "severity": "quality",
  "covers": ["U"],
  "customerScript": ["人工"]
}
