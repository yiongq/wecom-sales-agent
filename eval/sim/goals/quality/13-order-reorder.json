{
  "id": "qa-order-reorder",
  "persona": "你是已下单、尚未付款的客户（云南订单待付款），发现出发日期选错了，想改期并重新下单。你的每一句话都已由脚本给出，说完即结束。",
  "maxTurns": 2,
  "allowedTools": [
    "search_routes",
    "get_route_detail",
    "search_hotels",
    "create_quote",
    "generate_proposal",
    "create_order",
    "handoff_to_human"
  ],
  "predicates": [
    {
      "kind": "tool_called",
      "name": "create_order",
      "min": 1
    },
    {
      "kind": "reply_excludes",
      "pattern": "节假日价|旺季价|平日价|周末价|儿童价|早鸟|团购|半价|名额紧张|名额有限|房源紧俏|(?:这条线|该线路|线路|名额|档期|房源|位置|房间|席位)[^。，\\n]{0,6}抢手|最低价",
      "scope": "all",
      "negationAware": true
    },
    {
      "kind": "reply_excludes",
      "pattern": "产品库|线路库|系统里|查库|库里|工具返回",
      "scope": "all"
    },
    {
      "kind": "reply_excludes",
      "pattern": "availability|budget|package|option",
      "scope": "all"
    },
    {
      "kind": "reply_excludes",
      "pattern": "(?:[\\u{1F300}-\\u{1FAFF}\\u2600-\\u27BF].*){2,}",
      "scope": "all"
    },
    {
      "kind": "reply_excludes",
      "pattern": "已(?:为您)?(?:修改|改好)订单.{0,10}(?:无需|不用)重新",
      "scope": "all"
    },
    {
      "kind": "reply_excludes",
      "pattern": "重复(?:订单|下单)已生成",
      "scope": "all"
    }
  ],
  "forbidden": ["保证有房", "保证成行", "我保证给您升级酒店", "<state>", "<tool_call>", "【硬性要求】"],
  "severity": "quality",
  "covers": ["C"],
  "initial": {
    "stage": "closing",
    "profile": {
      "destinationInterest": "云南",
      "travelers": "2位",
      "dates": "2027-03-10"
    },
    "orders": [
      {
        "routeId": "r-yunnan-mid",
        "travelers": 2,
        "departDate": "2027-03-10",
        "status": "pending_payment"
      }
    ],
    "history": [
      {
        "role": "customer",
        "content": "两个人，2027年3月10日出发，就订丽江大理那条，确认下单"
      },
      {
        "role": "ai",
        "content": "好的，订单已生成，请点击支付链接完成付款，付款后顾问会在微信上联系您。"
      }
    ]
  },
  "customerScript": ["我发现日期错了，想改成 2027 年 3 月 17 日出发，旧订单怎么处理？", "确认，帮我重新下单"]
}
