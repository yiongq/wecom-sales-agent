{
  "id": "qa-long-multi-question",
  "persona": "你是客户，第一条消息已一次问完多个问题（线路、高反、价格、机票、发票、退改）。你想看对方是否逐一回答、是否漏问题。答复后追问一个被漏掉的点，然后结束，不下单。",
  "maxTurns": 8,
  "allowedTools": [
    "search_routes",
    "get_route_detail",
    "search_hotels",
    "create_quote",
    "generate_proposal",
    "create_order",
    "handoff_to_human"
  ],
  "predicates": [
    {
      "kind": "order",
      "count": 0
    },
    {
      "kind": "tool_called",
      "name": "search_routes",
      "min": 1
    },
    {
      "kind": "reply_excludes",
      "pattern": "保证.{0,6}(?:不会高反|没问题)|完全没问题",
      "scope": "all",
      "negationAware": true
    },
    {
      "kind": "reply_excludes",
      "pattern": "帮您(?:订|代订)机票",
      "scope": "all",
      "negationAware": true
    },
    {
      "kind": "reply_excludes",
      "pattern": "儿童价|孩子.{0,6}(?:半价|免费)",
      "scope": "all",
      "negationAware": true
    },
    {
      "kind": "reply_excludes",
      "pattern": "(?:可以|能|会|支持)(?:给您)?(?:开|提供)(?:增值税)?(?:普通)?发票",
      "scope": "all",
      "negationAware": true
    },
    {
      "kind": "reply_excludes",
      "pattern": "接近的线[：:]\\s*[·•]\\s*亮点",
      "scope": "all"
    },
    {
      "kind": "reply_excludes",
      "pattern": "(\\S[^。！？\\n]{5,}[？?])[\\s\\S]*?\\1",
      "scope": "all"
    },
    {
      "kind": "reply_excludes",
      "pattern": "节假日价|旺季价|平日价|周末价|儿童价|早鸟|团购|半价|名额紧张|名额有限|房源紧俏|(?:这条线|该线路|线路|名额|档期|房源|位置|房间|席位)[^。，\\n]{0,6}抢手|最低价",
      "scope": "all",
      "negationAware": true
    },
    {
      "kind": "reply_excludes",
      "pattern": "产品库|线路库|系统里|查库|库里|工具返回",
      "scope": "all"
    },
    {
      "kind": "reply_excludes",
      "pattern": "availability|budget|package|option",
      "scope": "all"
    },
    {
      "kind": "reply_excludes",
      "pattern": "(?:[\\u{1F300}-\\u{1FAFF}\\u2600-\\u27BF].*){2,}",
      "scope": "all"
    },
    {
      "kind": "shape",
      "richMax": 6,
      "plainMax": 3,
      "minShare": 0.7
    }
  ],
  "forbidden": ["保证有房", "保证成行", "我保证给您升级酒店", "<state>", "<tool_call>", "【硬性要求】"],
  "severity": "quality",
  "covers": ["E", "G", "Q"],
  "customerScript": [
    "我们一家四口（两个大人、一个 8 岁小孩、一位 68 岁老人）2027-05-01 想去云南，预算每人两万，有什么线路？老人会不会高反？多少钱？含不含机票？能不能开发票？退改怎么算？"
  ]
}
