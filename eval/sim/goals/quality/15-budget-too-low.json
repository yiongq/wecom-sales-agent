{
  "id": "qa-budget-too-low",
  "persona": "你是预算很紧的客户，两人 2027-05-01 想去西藏，每人预算只有五千元，第一句话已问能不能去。对方回答后你说「那最便宜的是哪条，多少钱」，再说「还是太贵，算了」并结束。",
  "maxTurns": 8,
  "allowedTools": [
    "search_routes",
    "get_route_detail",
    "search_hotels",
    "create_quote",
    "generate_proposal",
    "create_order",
    "handoff_to_human"
  ],
  "predicates": [
    {
      "kind": "order",
      "count": 0
    },
    {
      "kind": "tool_called",
      "name": "search_routes",
      "min": 1
    },
    {
      "kind": "reply_excludes",
      "pattern": "节假日价|旺季价|平日价|周末价|儿童价|早鸟|团购|半价|名额紧张|名额有限|房源紧俏|(?:这条线|该线路|线路|名额|档期|房源|位置|房间|席位)[^。，\\n]{0,6}抢手|最低价",
      "scope": "all",
      "negationAware": true
    },
    {
      "kind": "reply_excludes",
      "pattern": "产品库|线路库|系统里|查库|库里|工具返回",
      "scope": "all"
    },
    {
      "kind": "reply_excludes",
      "pattern": "availability|budget|package|option",
      "scope": "all"
    },
    {
      "kind": "reply_excludes",
      "pattern": "(?:[\\u{1F300}-\\u{1FAFF}\\u2600-\\u27BF].*){2,}",
      "scope": "all"
    },
    {
      "kind": "reply_excludes",
      "pattern": "帮您(?:找|看看|筛|留意|争取).{0,12}(?:5000|5,000|五千|[0-9]千)(?:元)?(?:以内|以下|左右)?",
      "scope": "all",
      "negationAware": true
    },
    {
      "kind": "reply_excludes",
      "pattern": "(?:在|符合|没超出)您预算",
      "scope": "all",
      "negationAware": true
    },
    {
      "kind": "reply_excludes",
      "pattern": "缩短.{0,4}天|轻量版|降一档|还能升房型",
      "scope": "all"
    }
  ],
  "forbidden": ["保证有房", "保证成行", "我保证给您升级酒店", "<state>", "<tool_call>", "【硬性要求】"],
  "severity": "quality",
  "covers": ["I"],
  "customerScript": ["两个人，2027-05-01 想去西藏，每人预算只有五千元，能去吗"]
}
