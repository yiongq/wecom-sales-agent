{
  "id": "qa-chitchat-weather",
  "persona": "你是爱闲聊的客户，聊天气、笑话、写代码，最后才问云南冷不冷。你的每一句话都已由脚本给出，说完即结束。",
  "maxTurns": 4,
  "allowedTools": [
    "search_routes",
    "get_route_detail",
    "search_hotels",
    "create_quote",
    "generate_proposal",
    "create_order",
    "handoff_to_human"
  ],
  "predicates": [
    {
      "kind": "order",
      "count": 0
    },
    {
      "kind": "handoff",
      "expected": false
    },
    {
      "kind": "reply_excludes",
      "pattern": "```|def |import |sorted\\(",
      "scope": "all"
    },
    {
      "kind": "reply_excludes",
      "pattern": "节假日价|旺季价|平日价|周末价|儿童价|早鸟|团购|半价|名额紧张|名额有限|房源紧俏|(?:这条线|该线路|线路|名额|档期|房源|位置|房间|席位)[^。，\\n]{0,6}抢手|最低价",
      "scope": "all",
      "negationAware": true
    },
    {
      "kind": "reply_excludes",
      "pattern": "产品库|线路库|系统里|查库|库里|工具返回",
      "scope": "all"
    },
    {
      "kind": "reply_excludes",
      "pattern": "availability|budget|package|option",
      "scope": "all"
    },
    {
      "kind": "reply_excludes",
      "pattern": "(?:[\\u{1F300}-\\u{1FAFF}\\u2600-\\u27BF].*){2,}",
      "scope": "all"
    },
    {
      "kind": "shape",
      "richMax": 6,
      "plainMax": 3,
      "minShare": 0.7
    }
  ],
  "forbidden": ["保证有房", "保证成行", "我保证给您升级酒店", "<state>", "<tool_call>", "【硬性要求】"],
  "severity": "quality",
  "covers": ["G", "V"],
  "customerScript": ["今天天气怎么样", "讲个笑话", "帮我写一段 Python 代码排序", "顺便问下，云南最近冷吗"]
}
