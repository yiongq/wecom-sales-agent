{
  "id": "qa-closing-after-quote",
  "persona": "你是拿到丽江大理报价后说要考虑考虑、道谢并结束的客户。你的每一句话都已由脚本给出，说完即结束。",
  "maxTurns": 4,
  "allowedTools": [
    "search_routes",
    "get_route_detail",
    "search_hotels",
    "create_quote",
    "generate_proposal",
    "create_order",
    "handoff_to_human"
  ],
  "predicates": [
    {
      "kind": "order",
      "count": 0
    },
    {
      "kind": "handoff",
      "expected": false
    },
    {
      "kind": "tool_called",
      "name": "create_quote",
      "min": 1
    },
    {
      "kind": "no_repeat",
      "pattern": "每人[^\\n。]{0,6}[0-9][0-9,]*\\s*元|总价|合计|总计",
      "unlessCustomer": "价|多少钱|报价|多少"
    },
    {
      "kind": "reply_matches",
      "pattern": "谢谢|不客气|随时|有问题|祝",
      "scope": "last"
    },
    {
      "kind": "reply_excludes",
      "pattern": "[\\u{1F300}-\\u{1FAFF}\\u2600-\\u27BF]",
      "scope": "last"
    },
    {
      "kind": "reply_excludes",
      "pattern": "节假日价|旺季价|平日价|周末价|儿童价|早鸟|团购|半价|名额紧张|名额有限|房源紧俏|(?:这条线|该线路|线路|名额|档期|房源|位置|房间|席位)[^。，\\n]{0,6}抢手|最低价",
      "scope": "all",
      "negationAware": true
    },
    {
      "kind": "reply_excludes",
      "pattern": "产品库|线路库|系统里|查库|库里|工具返回",
      "scope": "all"
    },
    {
      "kind": "reply_excludes",
      "pattern": "availability|budget|package|option",
      "scope": "all"
    },
    {
      "kind": "reply_excludes",
      "pattern": "(?:[\\u{1F300}-\\u{1FAFF}\\u2600-\\u27BF].*){2,}",
      "scope": "all"
    },
    {
      "kind": "reply_excludes",
      "pattern": "按最终行程.{0,8}微调|最终按行程微调|可能微调",
      "scope": "all",
      "after": {
        "tool": "create_quote"
      }
    },
    {
      "kind": "shape",
      "richMax": 6,
      "plainMax": 3,
      "minShare": 0.7
    }
  ],
  "forbidden": ["保证有房", "保证成行", "我保证给您升级酒店", "<state>", "<tool_call>", "【硬性要求】"],
  "severity": "quality",
  "covers": ["G", "N", "V"],
  "customerScript": ["两个人，2027年3月10日出发，丽江大理那条帮我报个价", "我再考虑考虑", "好的谢谢", "没有了"]
}
