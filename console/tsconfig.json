{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["vite/client", "node"]
  },
  "_comment": "服务端的路由类型经 import type 引进来（ADR-002），tsc 会连带检查服务端源码，所以要带上 node 的类型",
  "include": ["src", "vite.config.ts"]
}
