# ===== LLM 供应商 =====
# 一键切换：zhipu | deepseek（各读下方对应的一组变量，重新部署后生效）
LLM_PROVIDER=zhipu

# --- 智谱（LLM_PROVIDER=zhipu 时生效） ---
# 主对话用 glm-5.2。实测对照（各 12 次「想去四川/云南/新疆/西藏」）：
#   glm-5.2      12/12 立刻摆出真实线路
#   glm-4.5-air   4/12 —— 另外 8 次空手反问，违反 SOP 里「能查就别空聊」这条最重要的规则
# air 便宜约 10 倍、也快 1 秒，但按公开演示链接的真实流量算，差额只有每月十几到四十元，
# 不值得拿三分之二的首轮转化去换。
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-5.2
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# --- DeepSeek（LLM_PROVIDER=deepseek 时生效） ---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# 后台自用模型（AI 洞察 / 成交概率 / 下一步建议 / 沉默跟进话术）。
# **不配则跟随主对话模型**。实测后台单次调用 glm-5.2 只要 ¥0.0024，
# 按每天浏览后台一两百次算也就每月十几块，默认不降档。
# 想省这份钱就打开下面这行，便宜约 12 倍（单次 ¥0.0002），客户完全无感知：
# LLM_MODEL_CHEAP=glm-4.5-air
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# --- 兼容旧写法（不设 LLM_PROVIDER 时生效，任意 OpenAI 兼容端点） ---
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=
LLM_MODEL=glm-5.2

# 设为 1 时不调真实 LLM，走确定性脚本回复（离线开发/冒烟测试用）
LLM_MOCK=0

# LLM 请求超时（毫秒），默认 45000。这是**单次请求**的上限
LLM_TIMEOUT_MS=45000
# 一整轮对话（含全部工具往返 + 空回复重试）的墙钟上限，默认 120000。
# 没有它时最坏情况是 6 轮 × 45s × 重试 ≈ 14 分钟，期间同批次的其他企微客户全部干等。
# LLM_ROUND_TIMEOUT_MS=120000

# Docker 部署勿改此值：端口映射与健康检查写死容器内 3200，改了会导致外部完全不可达。
# 仅本地直跑（pnpm dev）时按需调整。
PORT=3200

# 管理后台登录（页面内自建登录框，非浏览器原生弹窗）。
# 后台鉴权分两层，不存在「一个开关全开」：
#   · 读：免密可看，但服务端只吐演示数据（wecom:cust_* 种子会话与 sim-* 网页访客），
#         真实企微客户会话在未登录时根本不进响应体。所以不填也能安全地公开演示。
#   · 写：接管 / 代客户发消息 / 交还 / AI 代拟，一律要下面这个密码，没有任何
#         环境变量能放行。不填时写操作返回 503（后台不可用），而不是变成全网可写。
# 接真实微信客户后务必设置——写权限意味着能以顾问身份给真人发消息。
ADMIN_USER=admin
ADMIN_PASS=

# 访客聊天 /api/chat 每 IP 每分钟限流（防止匿名刷 LLM 费用），默认 20
# CHAT_RATE_PER_MIN=20
# 靠 ID 访问的公开端点（订单查询/支付/访客会话/SSE）每 IP 每分钟限流，默认 60。
# 这些端点拿「不可猜的 ID」当凭据，限流是让穷举 ID 变得不可承受的那一半。
# LOOKUP_RATE_PER_MIN=60
# 信任的反代层数，用来决定限流键取 X-Forwarded-For 从右往左第几跳。
# **不能取 XFF 第一段**——那段由客户端自己写，换个假 IP 就是换个新桶，限流等于没有。
# 线上是单层 Caddy，所以是 1；没有反代直连时设 0（改用 socket 对端地址）。
# TRUST_PROXY_HOPS=1
# 请求体大小上限（字节），默认 65536。验签和限流都发生在读 body 之后，
# 没有上限时几条慢速大 body 请求就能把容器内存吃满。
# MAX_BODY_BYTES=65536

# ===== LLM 花费硬闸（链接公开时必配）=====
# 按 IP 限流挡不住持续刷：单 IP 20 条/分钟不停打，一天也有几万次真实 LLM 调用。
# 这里给「网页访客」的真实 LLM 轮次设每日总量上限，超额后网页端自动降级为离线脚本
# 回复（演示流程照样走得完，只是话术固定），企微真实客户不受影响。0 或不设 = 不限制。
# 参考：主对话一轮约 ¥0.03（glm-5.2）；后台走便宜档约 ¥0.003（glm-4.5-air）。按可接受的日预算除一下即可。
DAILY_VISITOR_LLM_CALLS=1500
# 单个网页访客会话最多多少轮走真实 LLM（防一个人长跑刷量），默认 60
# VISITOR_SESSION_LLM_CALLS=60

# ===== 演示数据自管理（链接对外公开时有用；不设则全部关闭） =====
# 演示种子会话（id 形如 wecom:cust_A01，由 scripts/seed-demo.py 生成）每小时自动把
# 时间戳前移，使后台永远显示「刚刚在聊」而不是一片「N 天未回应」。设 0 关闭。
# DEMO_FRESHEN=0
# 网页模拟器访客（sim- 会话）闲置超过 N 小时自动清理，避免公开链接的体验数据越积越多。
# 只清 chat.html 产生的匿名会话——企微真实客户会话与已支付订单永不清理。默认 24，设 0 关闭。
# DEMO_PRUNE_HOURS=24
# 访客会话总量硬上限，默认 5000。按时间清理挡不住突发刷量，超限即按最后活跃时间
# 淘汰最旧的（已支付订单对应的会话永不淘汰）。
# VISITOR_SESSION_MAX=5000

# 对外可访问的部署地址（企微消息里的支付链接会拼这个前缀）
PUBLIC_BASE_URL=http://localhost:3200

# 企业微信「微信客服」轮询接入（不填则只跑网页模拟器）
# 步骤：注册企微 → 开通微信客服建客服账号 → 建自建应用并绑定到
# 「微信客服-可调用接口的应用」→ 配企业可信 IP → 填以下三项
WECOM_CORP_ID=
WECOM_APP_SECRET=
WECOM_KF_OPEN_KFID=
# 兜底轮询间隔（毫秒，实际生效值最小 30000）。主通道是回调驱动，这只是兜底
WECOM_POLL_INTERVAL_MS=60000

# 企微「接收消息服务器 URL」验签用（后台设置 API 接收时生成的 Token/EncodingAESKey）
# 回调本身不承载消息（消息走轮询），但配置企业可信 IP 要求先通过回调 URL 验证
WECOM_CALLBACK_TOKEN=
WECOM_CALLBACK_AES_KEY=

# ===== 语义检索 =====
# 线路语义召回用的 embedding 模型（智谱）。索引在启动时构建并缓存到 var/route-vectors.json，
# 线路库内容变了自动重建；不可用时 search_routes 自动退回关键词匹配，不影响服务。
# EMBED_MODEL=embedding-3

# ===== 自动跟进（沉默唤醒）=====
# 报价后长时间没动静的客户自动追一条。只追企微真实客户，不骚扰网页访客；
# 每个销售阶段最多追一次，全程最多 FOLLOWUP_MAX_PER_SESSION 次。默认关闭。
# FOLLOWUP_ENABLED=1
# FOLLOWUP_MAX_PER_SESSION=2
# FOLLOWUP_SCAN_MS=900000
# FOLLOWUP_QUIET_START=22   # 夜间不打扰起始（含）
# FOLLOWUP_QUIET_END=9      # 次日恢复时间

# ===== LLM 并发闸 =====
# 同时在飞的模型请求上限。Node 的异步 I/O 只保证「我们自己不阻塞」，
# 不会限制发给服务商的并发量——一口气发几百个并发，服务商直接回 429，
# 客户全都收到「卡了一下」。这里在出口封顶，超出的排队等而不是丢弃。
# LLM_MAX_INFLIGHT=8
# 429 / 5xx / 网络抖动的重试次数（指数退避 + 抖动），0 表示不重试
# LLM_MAX_RETRY=2
