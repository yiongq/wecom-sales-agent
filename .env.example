# ===== LLM 供应商 =====
# 一键切换：zhipu | deepseek（各读下方对应的一组变量，重新部署后生效）
LLM_PROVIDER=zhipu

# --- 智谱（LLM_PROVIDER=zhipu 时生效） ---
# 主对话用 glm-5.3-flashx（强制思考模型，见下方「思考档位与对冲」）。2026-09-24 同机同时段实测
# （4 个目的地 × 12 次首轮 + 23 用例回归，新代码带引擎预取）：
#   glm-5.3-flashx  摆线路 48/48 · 首轮 P50 2.8s / P90 5.1s · 超 8 秒 0% · 回归 23/23 · 每千轮约 ¥4.8
#   glm-5.2         摆线路 48/48 · 首轮 P50 4.1s / P90 5.4s · 超 8 秒 4.2%（最坏 25s）· 回归 23/23 · 每千轮约 ¥16.4
# 注意 flashx 能过「单轮 8 秒」这条线靠的是引擎预取把首轮压成一次 API 往返——强制思考模型每次往返
# 固定多 2~3 秒，换回每轮多次往返的旧写法它会重新超线（旧代码下实测 21% 的轮次超 8 秒）。
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-5.3-flashx
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# --- DeepSeek（LLM_PROVIDER=deepseek 时生效） ---
# 切过来只换对话模型：语义召回的 embedding 仍走智谱（DeepSeek 没有 embeddings 接口），
# 要继续可用就保留 ZHIPU_API_KEY 或配下方 EMBED_*；否则 search_routes 退回关键词匹配。
# 下方 LLM_MODEL_CHEAP 若填的是 glm- 开头的模型，在 deepseek 下会被忽略（发给 DeepSeek 只会报错）。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# 后台自用模型（AI 洞察 / 成交概率 / 下一步建议 / 沉默跟进话术）。
# **不配则跟随主对话模型**——主模型已是 glm-5.3-flashx 这一档，后台没必要再单独降档。
# 主模型换回 glm-5.2 这类旗舰时，可打开下面这行省钱（单次约 ¥0.0027 → ¥0.00015，客户无感知）：
# LLM_MODEL_CHEAP=glm-4.7-flashx
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# --- 兼容旧写法（不设 LLM_PROVIDER 时生效，任意 OpenAI 兼容端点） ---
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=
LLM_MODEL=glm-5.3-flashx

# 设为 1 时不调真实 LLM，走确定性脚本回复（离线开发/冒烟测试用）
LLM_MOCK=0

# ===== 思考档位与对冲 =====
# glm-5.3 / 5.3-flash / 5.3-flashx 是强制思考模型（发 thinking.disabled 会 400），只能压档位：
# low | high | max，填错按 low。其他智谱模型照旧关闭思考，非智谱端点两个字段都不带。
# LLM_REASONING_EFFORT=low
# 对冲兜底（默认关）：主模型单次请求超过 LLM_HEDGE_MS 还没返回，或直接失败，就用对冲模型
# 同样的 messages 再问一次，谁先成功用谁。压的是偶发的 10 秒以上尾延迟；代价是被取消的那个请求
# 已生成的 token 照样计费。要与主模型不同才生效，且会多占一个 LLM_MAX_INFLIGHT 名额。
# 主模型 glm-5.3-flashx 时推荐对冲到 glm-5.2 @4000ms：实测 13~15% 的请求会加发、但 flashx 自己
# 几乎都先回来；它真正的用处是 flashx 偶发 10 秒以上的离群请求或直接报错时，把这一轮兜到 8~9.5 秒。
# glm-5.2 自己一次请求就要 4~5 秒，所以对冲救不回 8 秒以内，只是把「最坏 20 多秒」压下来。
LLM_HEDGE_MODEL=glm-5.2
LLM_HEDGE_MS=4000
# 同一轮里工具往返之后的调用（第 2 次起）的对冲阈值，默认 2800，且不超过 LLM_HEDGE_MS。
# 一轮耗时是几次往返相加，第二次调用卡住时等满 4 秒才对冲，整轮就冲过 8 秒线。代价：实测后续调用
# 30% 超 2.8 秒（超 4 秒的是 19%），多出来的对冲请求照样计费，而 glm-5.2 抢不过 flashx 3~5 秒的那档慢请求，
# 只在 6~7 秒以上的离群请求上早 1.2 秒兜住。/healthz 的 followupHedgeFired/Won 看不划算就设成与 LLM_HEDGE_MS 相同。
# LLM_HEDGE_MS_FOLLOWUP=2800
# 慢轮次阈值（毫秒），默认 8000。超过时打两行日志：[llm] 那行是模型工具循环里逐次调用的耗时（哪次慢、是否对冲、
# 调了什么工具），只从调模型开始算；[engine] 那行是整轮分段耗时（引擎预取 / 模型 / 出口修补），预取慢只有这行看得到。
# 网页 /api/chat 平时不记耗时，查慢轮次就靠这两行。
# LLM_SLOW_TURN_MS=8000

# LLM 请求超时（毫秒），默认 45000。这是**单次请求**的上限
LLM_TIMEOUT_MS=45000
# 一整轮对话（含全部工具往返 + 空回复重试）的墙钟上限，默认 120000。
# 没有它时最坏情况是 6 轮 × 45s × 重试 ≈ 14 分钟，期间同批次的其他企微客户全部干等。
# LLM_ROUND_TIMEOUT_MS=120000

# Docker 部署勿改此值：端口映射与健康检查写死容器内 3200，改了会导致外部完全不可达。
# 仅本地直跑（pnpm dev）时按需调整。
PORT=3200

# ===== 部署 profile =====
# demo | prod。不设或留空时运行时按 demo（零配置克隆、自测、eval 照旧可用）；但配了企微凭据
# （WECOM_CORP_ID / WECOM_APP_SECRET / WECOM_KF_OPEN_KFID 任一）而没设它，拒绝启动。
# 服务器上的 .env 必须显式写明其中一个（deploy.sh 会检查），所以这里不预填：照抄模板不会悄悄得到 demo。
# demo 下下面几个开关默认全开，就是演示实例现在的行为；prod 下全部封顶为关，设 on 会拒绝启动，并且必须配置 ADMIN_PASS。
# 启动日志的 [profile] 那一行列出实际生效的值。
# DEPLOY_PROFILE=demo
#
# 单个开关取 on | off，不设取 profile 的默认值。各开关管的事：
#   FLAG_RESET_COMMAND        「重置」口令（会清空会话和订单，含已付款的）
#   FLAG_ANON_READONLY_ADMIN  后台免密只读（种子会话 + 访客本人的会话）
#   FLAG_SEED_FRESHEN         种子演示数据的时间保鲜（旧变量 DEMO_FRESHEN=0 等价于 off）
#   FLAG_VISITOR_SIMULATOR    网页模拟器（匿名访客聊天）
#   FLAG_MOCK_PAY             不带管理凭据也能点的模拟支付
#   FLAG_AI_DISCLOSURE        AI 显式标识，00 只有 always
# 值后面不能跟注释：env 文件把 = 后面的整行都当成值。
# FLAG_RESET_COMMAND=on
# FLAG_ANON_READONLY_ADMIN=on
# FLAG_SEED_FRESHEN=on
# FLAG_VISITOR_SIMULATOR=on
# FLAG_MOCK_PAY=on
# FLAG_AI_DISCLOSURE=always

# 管理后台登录（页面内自建登录框，非浏览器原生弹窗）。
# 后台鉴权分两层，不存在「一个开关全开」：
#   · 读：免密可看，但服务端只吐演示数据（wecom:cust_* 种子会话与 sim-* 网页访客），
#         真实企微客户会话在未登录时根本不进响应体。所以不填也能安全地公开演示。
#   · 写：接管 / 代客户发消息 / 交还 / AI 代拟，一律要下面这个密码，没有任何
#         环境变量能放行。不填时写操作返回 503（后台不可用），而不是变成全网可写。
# 接真实微信客户后务必设置——写权限意味着能以顾问身份给真人发消息。
ADMIN_USER=admin
ADMIN_PASS=

# 访客聊天 /api/chat 每 IP 每分钟限流（防止匿名刷 LLM 费用），默认 20
# CHAT_RATE_PER_MIN=20
# 靠 ID 访问的公开端点（订单查询/支付/访客会话/SSE）每 IP 每分钟限流，默认 60。
# 这些端点拿「不可猜的 ID」当凭据，限流是让穷举 ID 变得不可承受的那一半。
# LOOKUP_RATE_PER_MIN=60
# 信任的反代层数，用来决定限流键取 X-Forwarded-For 从右往左第几跳。
# **不能取 XFF 第一段**——那段由客户端自己写，换个假 IP 就是换个新桶，限流等于没有。
# 线上是单层 Caddy，所以是 1；没有反代直连时设 0（改用 socket 对端地址）。
# TRUST_PROXY_HOPS=1
# 请求体大小上限（字节），默认 65536。验签和限流都发生在读 body 之后，
# 没有上限时几条慢速大 body 请求就能把容器内存吃满。
# MAX_BODY_BYTES=65536

# ===== LLM 花费硬闸（链接公开时必配）=====
# 按 IP 限流挡不住持续刷：单 IP 20 条/分钟不停打，一天也有几万次真实 LLM 调用。
# 这里给「网页访客」的真实 LLM 轮次设每日总量上限，超额后网页端自动降级为离线脚本
# 回复（演示流程照样走得完，只是话术固定），企微真实客户不受影响。0 或不设 = 不限制。
# 参考：主对话一轮约 ¥0.005（glm-5.3-flashx，glm-5.2 约 ¥0.016~0.03）；后台默认跟随主模型（flashx 约 ¥0.001/次）。
# 按可接受的日预算除一下即可。
DAILY_VISITOR_LLM_CALLS=1500
# 单个网页访客会话最多多少轮走真实 LLM（防一个人长跑刷量），默认 60
# VISITOR_SESSION_LLM_CALLS=60

# ===== 演示数据自管理（链接对外公开时有用；不设则全部关闭） =====
# 演示种子会话（id 形如 wecom:cust_A01，由 scripts/seed-demo.py 生成）每小时自动把
# 时间戳前移，使后台永远显示「刚刚在聊」而不是一片「N 天未回应」。设 0 关闭（等价于 FLAG_SEED_FRESHEN=off）。
# DEMO_FRESHEN=0
# 网页模拟器访客（sim- 会话）闲置超过 N 小时自动清理，避免公开链接的体验数据越积越多。
# 只清 chat.html 产生的匿名会话——企微真实客户会话与已支付订单永不清理。默认 24，设 0 关闭。
# DEMO_PRUNE_HOURS=24
# 访客会话总量硬上限，默认 5000。按时间清理挡不住突发刷量，超限即按最后活跃时间
# 淘汰最旧的（已支付订单对应的会话永不淘汰）。
# VISITOR_SESSION_MAX=5000

# 对外可访问的部署地址（企微消息里的支付链接会拼这个前缀）
PUBLIC_BASE_URL=http://localhost:3200

# 企业微信「微信客服」轮询接入（不填则只跑网页模拟器）
# 步骤：注册企微 → 开通微信客服建客服账号 → 建自建应用并绑定到
# 「微信客服-可调用接口的应用」→ 配企业可信 IP → 填以下三项
WECOM_CORP_ID=
WECOM_APP_SECRET=
WECOM_KF_OPEN_KFID=
# 兜底轮询间隔（毫秒，实际生效值最小 30000）。主通道是回调驱动，这只是兜底
WECOM_POLL_INTERVAL_MS=60000

# 企微「接收消息服务器 URL」验签用（后台设置 API 接收时生成的 Token/EncodingAESKey）
# 回调本身不承载消息（消息走轮询），但配置企业可信 IP 要求先通过回调 URL 验证
WECOM_CALLBACK_TOKEN=
WECOM_CALLBACK_AES_KEY=

# ===== 语义检索 =====
# 线路语义召回用的 embedding 模型（智谱）。索引在启动时构建并缓存到 var/route-vectors.json，
# 线路库内容变了自动重建；不可用时 search_routes 自动退回关键词匹配，不影响服务。
# EMBED_MODEL=embedding-3
# embedding 的端点与 key，不配时回落到智谱配置（LLM_PROVIDER=zhipu 或旧写法时就是主对话那组；
# 其他供应商时只认 ZHIPU_API_KEY，不会把别家的 key 发给智谱）。
# EMBED_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# EMBED_API_KEY=

# ===== 自动跟进（沉默唤醒）=====
# 报价后长时间没动静的客户自动追一条。只追企微真实客户，不骚扰网页访客；
# 每个销售阶段最多追一次，全程最多 FOLLOWUP_MAX_PER_SESSION 次。默认关闭。
# FOLLOWUP_ENABLED=1
# FOLLOWUP_MAX_PER_SESSION=2
# FOLLOWUP_SCAN_MS=900000
# FOLLOWUP_QUIET_START=22   # 夜间不打扰起始（含）
# FOLLOWUP_QUIET_END=9      # 次日恢复时间

# ===== LLM 并发闸 =====
# 同时在飞的模型请求上限。Node 的异步 I/O 只保证「我们自己不阻塞」，
# 不会限制发给服务商的并发量——一口气发几百个并发，服务商直接回 429，
# 客户全都收到「卡了一下」。这里在出口封顶，超出的排队等而不是丢弃。
# LLM_MAX_INFLIGHT=8
# 429 / 5xx / 网络抖动的重试次数（指数退避 + 抖动），0 表示不重试
# LLM_MAX_RETRY=2

# ===== 配置源（01 spec「两种模式与启动装载」） =====
# 不设、空串或 file：SOP 与产品库读 data/ 下的文件（现状）。db：从 Postgres 装载，启动时校验，每轮不查库。
# DB 模式下下面三项必填，DEPLOY_PROFILE 也必须显式写（见上），缺了拒绝启动。
# CONFIG_SOURCE=file
# DATABASE_URL=postgres://agent_app:<口令>@db:5432/agent   # 只能是 agent_app 的连接串
# DEFAULT_TENANT_SLUG=demo
# 迁移用的 DATABASE_OWNER_URL、平台命令行用的 DATABASE_PLATFORM_URL 不写进这里：它们只给 compose 的 migrate、platform 服务，
# 开发机上在命令行前临时给出。app 的环境里出现它们（或 POSTGRES_PASSWORD、AGENT_*_PASSWORD），DB 模式拒绝启动。
# 数据库自测的真实 Postgres 部分：一个专用测试集群的超级用户连接串（会建临时库、改 agent_* 角色的口令），见 CONTRIBUTING
# PG_TEST_URL=postgres://postgres:<口令>@127.0.0.1:55432/postgres
